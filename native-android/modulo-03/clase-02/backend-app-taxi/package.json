{
    "name": "backend-app-taxi",
    "version": "0.0.1",
    "description": "",
    "author": "",
    "private": true,
    "license": "UNLICENSED",
    "packageManager": "pnpm@12.5.1",
    "engines": {
        "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
    },
    "scripts": {
        "build": "nest build",
        "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
        "start": "nest start",
        "start:dev": "nest start --watch",
        "start:debug": "nest start --debug --watch",
        "start:prod": "node dist/main",
        "test": "node --experimental-vm-modules --disable-warning=ExperimentalWarning node_modules/jest/bin/jest.js",
        "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
        "migration:generate": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:generate -d src/core/database/typeorm.migration.ts",
        "migration:run": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:run -d src/core/database/typeorm.migration.ts",
        "migration:revert": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:revert -d src/core/database/typeorm.migration.ts"
    },
    "dependencies": {
        "@nestjs/common": "^12.0.3",
        "@nestjs/config": "^12.0.0",
        "@nestjs/core": "^12.0.3",
        "@nestjs/jwt": "^12.0.2",
        "@nestjs/mapped-types": "^12.0.0",
        "@nestjs/platform-express": "^12.0.3",
        "@nestjs/serve-static": "^12.0.0",
        "@nestjs/swagger": "^12.0.1",
        "@nestjs/typeorm": "^12.0.1",
        "argon2": "^0.45.1",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.15.1",
        "dotenv": "^18.0.1",
        "i18n": "^0.15.4",
        "ioredis": "^5.11.1",
        "lodash": "^4.18.1",
        "mysql2": "^3.24.4",
        "nestjs-i18n": "^10.8.5",
        "nestjs-pino": "^5.2.0",
        "pino": "^10.3.1",
        "redis": "^6.2.1",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.8.2",
        "swagger-ui-express": "^5.0.1",
        "typeorm": "^1.1.1"
    },
    "devDependencies": {
        "@eslint/eslintrc": "^3.3.7",
        "@eslint/js": "^10.0.1",
        "@nestjs/cli": "^12.0.3",
        "@nestjs/schematics": "^12.0.3",
        "@nestjs/testing": "^12.0.3",
        "@swc/cli": "^0.8.1",
        "@swc/core": "^1.16.2",
        "@types/express": "^5.0.6",
        "@types/jest": "^30.0.0",
        "@types/node": "^24.13.6",
        "@types/supertest": "^7.2.1",
        "eslint": "^10.11.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.6",
        "globals": "^17.12.0",
        "jest": "^30.5.2",
        "pino-pretty": "^13.1.3",
        "prettier": "^3.9.8",
        "source-map-support": "^0.5.21",
        "supertest": "^7.2.2",
        "ts-jest": "^29.4.12",
        "ts-loader": "^9.6.2",
        "ts-node": "^10.9.2",
        "tsconfig-paths": "^4.2.0",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.70.0"
    },
    "jest": {
        "moduleFileExtensions": [
            "js",
            "json",
            "ts"
        ],
        "rootDir": "src",
        "testRegex": ".*\\.spec\\.ts$",
        "transform": {
            "^.+\\.(t|j)s$": "ts-jest"
        },
        "collectCoverageFrom": [
            "**/*.(t|j)s"
        ],
        "coverageDirectory": "../coverage",
        "testEnvironment": "node",
        "moduleNameMapper": {
            "^src/(.*)$": "<rootDir>/$1"
        }
    }
}
