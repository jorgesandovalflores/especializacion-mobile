rules_version = '2';

// Foto de perfil del pasajero: passengers/{passengerId}/avatar.jpg
// - request.auth.uid viene del custom token que firma el backend (uid = id del pasajero)
// - Solo el dueño escribe; solo imágenes de menos de 5 MB
service firebase.storage {
  match /b/{bucket}/o {
    match /passengers/{passengerId}/avatar.jpg {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.auth.uid == passengerId
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
  }
}
